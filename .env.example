# Ключи провайдеров. Секреты задаются локально; этот шаблон значений не содержит.
# Платный резерв основного пакетного CLI.
DEEPSEEK_API_KEY=

# Рабочая цепочка: Gemini → NVIDIA NIM → Groq → OpenRouter :free → платный DeepSeek.
# Gemini/NVIDIA требуют ключ и модель этапа; Groq/OpenRouter имеют профили по умолчанию.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=
GEMINI_CLASSIFICATION_MODEL=

NVIDIA_API_KEY=
# Модель выбирается по актуальному API-каталогу и проверяется для каждого этапа.
# Qwen3.5-122b-a10b снята с hosted API (реальный HTTP 410).
NVIDIA_OCR_MODEL=
NVIDIA_CLASSIFICATION_MODEL=

# Groq через curl: отсутствие переменной выбирает профиль, пустая отключает этап.
GROQ_API_KEY=
GROQ_OCR_MODEL=qwen/qwen3.8-27b
GROQ_CLASSIFICATION_MODEL=openai/gpt-oss-120b

# OpenRouter: отсутствующая переменная модели выбирает профиль ниже;
# явно пустая отключает этап. Другие модели также должны иметь суффикс :free.
# OPEN_ROUTER_API_KEY также поддерживается; OPENROUTER_API_KEY приоритетен.
OPENROUTER_API_KEY=
OPENROUTER_OCR_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_CLASSIFICATION_MODEL=particle-ai/particle-1:free

# Настройки основного DeepSeek-клиента.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONNECT_TIMEOUT=15
DEEPSEEK_READ_TIMEOUT=120
DEEPSEEK_MAX_TOKENS=16384
DEEPSEEK_CLASSIFICATION_THINKING=disabled

# Разрешение изображений страниц основного OCR.
OCR_DPI=300

# Локальные квоты: положительные целые числа из настроек вашего аккаунта.
# Пустое значение отключает этот лимит. RPM: последние 60 секунд, RPD: 24 часа.
# OCR и классификация делят квоту провайдера, включая неуспешные HTTP-попытки.
# Серверный cooldown сохраняется между CLI-запусками даже при пустых RPM/RPD.
GEMINI_RPM=
GEMINI_RPD=
NVIDIA_RPM=
NVIDIA_RPD=
GROQ_RPM=
GROQ_RPD=
OPENROUTER_RPM=
OPENROUTER_RPD=
DEEPSEEK_RPM=
DEEPSEEK_RPD=
