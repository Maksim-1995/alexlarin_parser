# Ключи провайдеров. Секреты задаются локально; этот шаблон значений не содержит.
# Платный резерв основного пакетного CLI.
DEEPSEEK_API_KEY=

# Бесплатная цепочка: Gemini → NVIDIA NIM → Groq → OpenRouter :free.
# Для включения провайдера нужны ключ и модель соответствующего этапа.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=
GEMINI_CLASSIFICATION_MODEL=

NVIDIA_API_KEY=
NVIDIA_OCR_MODEL=
NVIDIA_CLASSIFICATION_MODEL=

GROQ_API_KEY=
GROQ_OCR_MODEL=
GROQ_CLASSIFICATION_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_OCR_MODEL=
OPENROUTER_CLASSIFICATION_MODEL=

# Настройки основного DeepSeek-клиента.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONNECT_TIMEOUT=15
DEEPSEEK_READ_TIMEOUT=120
DEEPSEEK_MAX_TOKENS=16384
DEEPSEEK_CLASSIFICATION_THINKING=disabled

# Разрешение изображений страниц основного OCR.
OCR_DPI=300
